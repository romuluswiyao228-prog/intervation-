# URL de votre projet Supabase (https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Clé publique anon (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=

# Vérification SMS à l'inscription.
# true  : un code SMS est exigé (recommandé en production)
# false : DEV UNIQUEMENT, le compte est créé avec phone_verified = false
VITE_PHONE_VERIFICATION_REQUIRED=true
